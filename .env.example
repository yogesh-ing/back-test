# mStock TypeA API credentials (used only by the `mstock` data source)
MSTOCK_API_KEY=
MSTOCK_USERNAME=
MSTOCK_PASSWORD=
# 'W' in the reference SDK; leave as-is unless mStock tells you otherwise
MSTOCK_CHECKSUM=W
# Auth mode: 'otp' (SMS one-time code) or 'totp' (authenticator app). Default 'otp'.
MSTOCK_AUTH_MODE=
# Optional: base URL override (defaults to https://api.mstock.trade)
MSTOCK_BASE_URL=https://api.mstock.trade