# mStock TypeA API credentials (used only by the `mstock` data source)
MSTOCK_API_KEY=
MSTOCK_USERNAME=
MSTOCK_PASSWORD=
# 'W' in the reference SDK; leave as-is unless mStock tells you otherwise
MSTOCK_CHECKSUM=W
# Auth mode: 'otp' (SMS one-time code) or 'totp' (authenticator app). Default 'otp'.
MSTOCK_AUTH_MODE=
# Optional: base URL override (defaults to https://api.mstock.trade)
MSTOCK_BASE_URL=https://api.mstock.trade
# Optional: assumed session lifetime in minutes when the mStock API response
# carries no expiry hint (used by the generic broker auth layer; default 390)
MSTOCK_SESSION_TTL_MINUTES=390

# =============================================================================
# Dhan (DhanHQ v2) - placeholder only; client ID + PIN + TOTP come from the
# login form at runtime (NOT stored here). Fill in your data API access key.
# =============================================================================
DHAN_API_KEY=
# Optional: assumed session lifetime in minutes when Dhan's token response
# carries no expiry hint (default 390)
#DHAN_SESSION_TTL_MINUTES=390

# =============================================================================
# Outbound alert notifications (Telegram / email) — config/alerts.yaml
# =============================================================================
# The notifier ships alerts (incl. circuit-breaker trips) out of the process:
# log channel always on; Telegram and email switch on when their credentials
# are set. See docs/ALERTS-GUIDE.md.
# Master off-switch: 0 disables ALL outbound channels (in-app alerts stay on).
#ALERT_NOTIFIER=1
# Profile from config/alerts.yaml: default | dev | production | telegram_only
#ALERT_PROFILE=default
# Telegram — enabled automatically when BOTH of these are set
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
# Inbound Telegram commands (/status /kill /segments /arming) — the listener
# starts when TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID are set (the control chat
# is allowed automatically). Master off-switch: 0 disables it entirely.
#TELEGRAM_COMMANDS=1
# Extra chat ids allowed to send commands (comma-separated)
#TELEGRAM_ALLOWED_CHATS=
# Long-poll seconds (higher = fewer polls, slower replies)
#TELEGRAM_POLL_TIMEOUT_S=25
# Email — enabled automatically when host + ALERT_TO_EMAILS are set
#ALERT_SMTP_HOST=
#ALERT_SMTP_PORT=587
#ALERT_SMTP_USER=
#ALERT_EMAIL_PASSWORD=
# Defaults to ALERT_SMTP_USER when empty
#ALERT_FROM_EMAIL=
# Comma-separated recipients
#ALERT_TO_EMAILS=
# Set to 0 for a relay without TLS (STARTTLS is on by default)
#ALERT_SMTP_STARTTLS=1

# =============================================================================
# Forward testing database (Step 1+)
# =============================================================================
# SQLAlchemy connection URL. Used by the app and by Alembic (db/alembic/env.py).
#
# PostgreSQL (production):
#   FORWARD_TEST_DB_URL=postgresql+psycopg2://ft_app:CHANGE_ME@localhost:5432/forward_test
#
# SQLite (local development — zero setup, file created on first connect):
#   FORWARD_TEST_DB_URL=sqlite:///forward_test.db
#
FORWARD_TEST_DB_URL=sqlite:///forward_test.db

# Which profile in config/database.yaml to activate.
# One of: development | testing | production
FORWARD_TEST_DB_PROFILE=development

# --- Optional overrides (defaults come from config/database.yaml) ---
# Connection pool bounds. Production defaults are 5 / 20.
#FORWARD_TEST_DB_POOL_MIN_SIZE=5
#FORWARD_TEST_DB_POOL_MAX_SIZE=20

# Log every statement and its duration at DEBUG level.
#FORWARD_TEST_DB_LOG_QUERIES=false
# Warn about statements slower than this (ms). 0 disables.
#FORWARD_TEST_DB_SLOW_QUERY_MS=500

# Retry attempts for TRANSIENT faults only (dropped connection, server
# restart). Constraint violations and SQL errors are never retried.
#FORWARD_TEST_DB_RETRY_ATTEMPTS=3

# Point at a different YAML config file.
#FORWARD_TEST_DB_CONFIG=/etc/forward_test/database.yaml

# Echo every SQL statement via SQLAlchemy's own logger. Very noisy;
# prefer FORWARD_TEST_DB_LOG_QUERIES.
FORWARD_TEST_DB_ECHO=false

# ---------------------------------------------------------------------------
# Logging (all entry points: web app, CLI, forward engine)
# ---------------------------------------------------------------------------
# DEBUG | INFO (default) | WARNING | ERROR | ALL — "ALL" also un-quiets
# werkzeug / urllib3 / SQLAlchemy.  See docs/LOGGING.md.
#BACKTEST_LOG_LEVEL=INFO
# Append every log line to this file as well as the console (the web app also
# accepts --log-file / --log-level).  Parent directories are created.
#BACKTEST_LOG_FILE=logs/app.log

# ---------------------------------------------------------------------------
# Production server (gunicorn — Linux)
# ---------------------------------------------------------------------------
# Boot: gunicorn -c gunicorn.conf.py backtest.web.wsgi:app
# Default backtest data source for this deployment (synthetic | csv | mstock | dhan | db)
#BACKTEST_SOURCE=synthetic
# Bind address (default 127.0.0.1:5000). SECURITY: the app has no login of
# its own — do not expose it beyond localhost without an authenticated proxy.
#GUNICORN_BIND=127.0.0.1:5000
#GUNICORN_THREADS=8
#GUNICORN_TIMEOUT=600

# ---------------------------------------------------------------------------
# Web UI presentation & forward-test clock
# ---------------------------------------------------------------------------
# Money display for every page (Backtest, Compare, Forward, Dashboard, Portfolio).
# INR (₹, en-IN lakh/crore grouping) is the default; USD/EUR/GBP/JPY/AUD/SGD or a
# bare symbol like "Rp" also work.  CLI flag: --currency
#BACKTEST_CURRENCY=INR
# How fast a forward-test replay reveals bars, in bars per second. The clock runs
# on the server, so the bot keeps moving with no tab open; 0 = manual stepping.
# CLI flag: --replay-speed   (a single session can override it via bars_per_second)
#FORWARD_REPLAY_SPEED=1.0
