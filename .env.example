# mStock TypeA API credentials (used only by the `mstock` data source)
MSTOCK_API_KEY=
MSTOCK_USERNAME=
MSTOCK_PASSWORD=
# 'W' in the reference SDK; leave as-is unless mStock tells you otherwise
MSTOCK_CHECKSUM=W
# Auth mode: 'otp' (SMS one-time code) or 'totp' (authenticator app). Default 'otp'.
MSTOCK_AUTH_MODE=
# Optional: base URL override (defaults to https://api.mstock.trade)
MSTOCK_BASE_URL=https://api.mstock.trade

# =============================================================================
# Forward testing database (Step 1+)
# =============================================================================
# SQLAlchemy connection URL. Used by the app and by Alembic (db/alembic/env.py).
#
# PostgreSQL (production):
#   FORWARD_TEST_DB_URL=postgresql+psycopg2://ft_app:CHANGE_ME@localhost:5432/forward_test
#
# SQLite (local development — zero setup, file created on first connect):
#   FORWARD_TEST_DB_URL=sqlite:///forward_test.db
#
FORWARD_TEST_DB_URL=sqlite:///forward_test.db

# Which profile in config/database.yaml to activate.
# One of: development | testing | production
FORWARD_TEST_DB_PROFILE=development

# --- Optional overrides (defaults come from config/database.yaml) ---
# Connection pool bounds. Production defaults are 5 / 20.
#FORWARD_TEST_DB_POOL_MIN_SIZE=5
#FORWARD_TEST_DB_POOL_MAX_SIZE=20

# Log every statement and its duration at DEBUG level.
#FORWARD_TEST_DB_LOG_QUERIES=false
# Warn about statements slower than this (ms). 0 disables.
#FORWARD_TEST_DB_SLOW_QUERY_MS=500

# Retry attempts for TRANSIENT faults only (dropped connection, server
# restart). Constraint violations and SQL errors are never retried.
#FORWARD_TEST_DB_RETRY_ATTEMPTS=3

# Point at a different YAML config file.
#FORWARD_TEST_DB_CONFIG=/etc/forward_test/database.yaml

# Echo every SQL statement via SQLAlchemy's own logger. Very noisy;
# prefer FORWARD_TEST_DB_LOG_QUERIES.
FORWARD_TEST_DB_ECHO=false
